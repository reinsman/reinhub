{
    "swagger": "2.0",
    "info": {
        "description": "This is a sample template server.",
        "title": "go-examplesrv",
        "contact": {
            "name": "xhb",
            "url": "https://chatgpt.com/",
            "email": "support@examplesrv.com"
        },
        "license": {
            "name": "Private"
        },
        "version": "0.1.0"
    },
    "host": "localhost:9010",
    "basePath": "/",
    "paths": {
        "/api/v1/dummy/{id}": {
            "put": {
                "description": "演示参数绑定",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "/api/v1"
                ],
                "summary": "Dummy",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "用户id",
                        "name": "_HCID",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "enum": [
                            "active",
                            "inactive",
                            "pending"
                        ],
                        "type": "string",
                        "description": "用户状态",
                        "name": "status",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 0,
                        "description": "分页偏移",
                        "name": "offset",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "每页数量",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "description": "请求体",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/user.DummyReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功code为0，其他code为失败,失败时data可能为nil",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/rsp.Rsp"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/user.DummyData"
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        },
        "/api/v1/user": {
            "get": {
                "description": "按 uid 或 name 查询用户，都不传则查当前登录用户",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "/api/v1"
                ],
                "summary": "获取用户信息",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "用户ID",
                        "name": "uid",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "用户名",
                        "name": "name",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/rsp.Rsp"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/user.UserInfoData"
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        },
        "/self/ping": {
            "get": {
                "description": "ping ping ping",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "/self"
                ],
                "summary": "Ping",
                "responses": {
                    "200": {
                        "description": "成功code为0，其他code为失败,失败时data可能为nil",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/rsp.Rsp"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/ping.Pong"
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "ping.Pong": {
            "type": "object",
            "properties": {
                "commitid": {
                    "type": "string"
                },
                "health": {
                    "type": "integer"
                }
            }
        },
        "rsp.Rsp": {
            "type": "object",
            "properties": {
                "_cost": {
                    "type": "integer"
                },
                "_err": {
                    "type": "string"
                },
                "code": {
                    "type": "integer"
                },
                "data": {},
                "msg": {
                    "type": "string"
                }
            }
        },
        "user.DummyData": {
            "type": "object",
            "properties": {
                "echo": {
                    "type": "integer"
                }
            }
        },
        "user.DummyReq": {
            "type": "object",
            "required": [
                "id"
            ],
            "properties": {
                "id": {
                    "type": "integer"
                },
                "panic": {
                    "type": "boolean"
                }
            }
        },
        "user.UserInfoData": {
            "type": "object",
            "properties": {
                "account_id": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "uid": {
                    "type": "integer"
                },
                "user_name": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "ApiKeyAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}